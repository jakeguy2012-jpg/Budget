generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  viewer_editor
}

enum ProviderType {
  simplefin
  csv
  plaid
  demo
}

enum TransactionDirection {
  income
  expense
  transfer
}

enum SyncStatus {
  running
  completed
  failed
}

enum AuditAction {
  login
  connection_added
  connection_updated
  connection_deleted
  sync_started
  sync_completed
  sync_failed
  category_changed
  budget_changed
}

model Household {
  id          String                @id @default(cuid())
  name        String
  users       User[]
  connections FinancialConnection[]
  categories  Category[]
  budgets     Budget[]
  budgetMonths BudgetMonth[]
  auditLogs   AuditLog[]
  merchantAliases MerchantAlias[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model User {
  id           String    @id @default(cuid())
  householdId  String
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name         String
  username     String    @unique
  passwordHash String
  role         UserRole
  auditLogs    AuditLog[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model FinancialConnection {
  id                  String       @id @default(cuid())
  householdId          String
  household            Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  provider             ProviderType
  name                 String
  encryptedCredentials String?
  isActive             Boolean      @default(true)
  lastSyncedAt         DateTime?
  accounts             Account[]
  syncRuns             SyncRun[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model Account {
  id                String       @id @default(cuid())
  providerAccountId String
  connectionId       String
  connection         FinancialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  name              String
  officialName      String?
  type              String
  subtype           String?
  mask              String?
  currentBalance    Decimal      @default(0) @db.Decimal(12, 2)
  availableBalance  Decimal?     @db.Decimal(12, 2)
  currency          String       @default("USD")
  isActive          Boolean      @default(true)
  transactions      Transaction[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([connectionId, providerAccountId])
}

model Transaction {
  id                    String               @id @default(cuid())
  providerTransactionId String?
  accountId             String
  account               Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date                  DateTime
  postedDate            DateTime?
  description           String
  merchantName          String?
  originalDescription   String?
  amount                Decimal              @db.Decimal(12, 2)
  direction             TransactionDirection
  categoryId            String?
  category              Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userReviewed          Boolean              @default(false)
  excludedFromBudget    Boolean              @default(false)
  notes                 String?
  tags                  String[]             @default([])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([accountId, providerTransactionId])
  @@index([date])
  @@index([categoryId])
}

model Category {
  id          String       @id @default(cuid())
  householdId String
  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  color       String       @default("#2563eb")
  icon        String       @default("circle")
  isDefault   Boolean      @default(false)
  transactions Transaction[]
  rules       CategoryRule[]
  budgets     Budget[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([householdId, name])
}

model CategoryRule {
  id                    String    @id @default(cuid())
  householdId            String
  categoryId             String
  category               Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  merchantContains       String?
  descriptionContains    String?
  amountEquals           Decimal? @db.Decimal(12, 2)
  amountGreaterThan      Decimal? @db.Decimal(12, 2)
  amountLessThan         Decimal? @db.Decimal(12, 2)
  accountId              String?
  excludeFromBudget      Boolean  @default(false)
  priority               Int      @default(100)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([householdId, priority])
}

model Budget {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  month       DateTime
  planned     Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([householdId, categoryId, month])
}

model BudgetMonth {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  month       DateTime
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([householdId, month])
}

model MerchantAlias {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  alias       String
  canonical   String
  createdAt   DateTime  @default(now())

  @@unique([householdId, alias])
}

model SyncRun {
  id                   String       @id @default(cuid())
  connectionId          String
  connection            FinancialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  provider              ProviderType
  startedAt             DateTime     @default(now())
  endedAt               DateTime?
  status                SyncStatus
  accountsSynced        Int          @default(0)
  transactionsInserted  Int          @default(0)
  transactionsUpdated   Int          @default(0)
  errorMessage          String?
}

model AuditLog {
  id          String      @id @default(cuid())
  householdId String
  household   Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      AuditAction
  entityType  String?
  entityId    String?
  metadata    Json?
  createdAt   DateTime    @default(now())
}
